{
  "name": "mals-pies-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mal's Pies & Pastries, Oonoonba, Townsville: one-page site built from the approved Model 2 board (The First Bite).",
  "scripts": {
    "dev": "vite --port 4396 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4397 --strictPort",
